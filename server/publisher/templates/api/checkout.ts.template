import { NextRequest, NextResponse } from 'next/server';
import { supabaseAdmin } from '@/lib/supabase-admin';

const websiteId = process.env.WEBSITE_ID || '';

type CartItem = {
  product: {
    id: string;
    name: string;
    price: string;
    stock: number;
  };
  quantity: number;
};

type DecrementedProduct = {
  productId: string;
  quantity: number;
};

async function rollbackDecrements(decremented: DecrementedProduct[]): Promise<void> {
  for (const item of decremented) {
    try {
      const { data: current } = await supabaseAdmin
        .from('products')
        .select('stock')
        .eq('id', item.productId)
        .eq('website_id', websiteId)
        .single();
      
      if (current) {
        await supabaseAdmin
          .from('products')
          .update({ stock: current.stock + item.quantity })
          .eq('id', item.productId)
          .eq('website_id', websiteId);
      }
    } catch (err) {
      console.error('Rollback failed:', item.productId, err);
    }
  }
}

export async function POST(request: NextRequest) {
  const decremented: DecrementedProduct[] = [];
  
  try {
    const { items, customerName, customerEmail, customerPhone } = await request.json();

    if (!items?.length) {
      return NextResponse.json({ error: 'Cart is empty' }, { status: 400 });
    }

    if (!customerName || !customerEmail) {
      return NextResponse.json({ error: 'Name and email required' }, { status: 400 });
    }

    const productIds = items.map((i: CartItem) => i.product.id);
    
    const { data: products, error: fetchError } = await supabaseAdmin
      .from('products')
      .select('id, name, price, stock')
      .in('id', productIds)
      .eq('website_id', websiteId)
      .eq('status', 'active');

    if (fetchError || !products) {
      return NextResponse.json({ error: 'Failed to fetch products' }, { status: 500 });
    }

    const productMap = new Map(products.map(p => [p.id, p]));

    for (const item of items as CartItem[]) {
      const product = productMap.get(item.product.id);
      if (!product) {
        return NextResponse.json({ error: `Product not found: ${item.product.name}` }, { status: 400 });
      }
      if (product.stock < item.quantity) {
        return NextResponse.json({ 
          error: `Insufficient stock for ${product.name} (${product.stock} available)` 
        }, { status: 400 });
      }
    }

    let total = 0;
    const orderItems: Array<{ productId: string; name: string; price: number; quantity: number }> = [];

    for (const item of items as CartItem[]) {
      const product = productMap.get(item.product.id)!;
      
      const { data: current } = await supabaseAdmin
        .from('products')
        .select('stock')
        .eq('id', product.id)
        .eq('website_id', websiteId)
        .single();

      if (!current || current.stock < item.quantity) {
        await rollbackDecrements(decremented);
        return NextResponse.json({ 
          error: `Stock unavailable for ${product.name}. Please refresh and try again.` 
        }, { status: 409 });
      }

      const { data: updated, error: updateErr } = await supabaseAdmin
        .from('products')
        .update({ stock: current.stock - item.quantity })
        .eq('id', product.id)
        .eq('website_id', websiteId)
        .eq('stock', current.stock)
        .select('id');

      if (updateErr || !updated || updated.length === 0) {
        await rollbackDecrements(decremented);
        return NextResponse.json({ 
          error: `Stock changed for ${product.name}. Please refresh and try again.` 
        }, { status: 409 });
      }

      decremented.push({ productId: product.id, quantity: item.quantity });
      
      const price = parseFloat(product.price);
      total += price * item.quantity;
      orderItems.push({
        productId: product.id,
        name: product.name,
        price,
        quantity: item.quantity,
      });
    }

    const { data: order, error: orderErr } = await supabaseAdmin
      .from('orders')
      .insert({
        website_id: websiteId,
        customer_name: customerName,
        customer_email: customerEmail,
        customer_phone: customerPhone || null,
        status: 'pending',
        total: total.toFixed(2),
        items: orderItems,
      })
      .select('id')
      .single();

    if (orderErr) {
      await rollbackDecrements(decremented);
      return NextResponse.json({ error: 'Failed to create order' }, { status: 500 });
    }

    return NextResponse.json({ success: true, orderId: order.id });
  } catch (error) {
    console.error('Checkout error:', error);
    if (decremented.length) await rollbackDecrements(decremented);
    return NextResponse.json({ error: 'Checkout failed' }, { status: 500 });
  }
}
