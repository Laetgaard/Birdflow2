import { NextRequest, NextResponse } from 'next/server';
import { supabaseAdmin } from '@/lib/supabase-admin';

const websiteId = process.env.WEBSITE_ID || '';

type CartItem = {
  product: {
    id: string;
    name: string;
    price: string;
    stock: number;
  };
  quantity: number;
};

export async function POST(request: NextRequest) {
  try {
    const { items, customerName, customerEmail, customerPhone } = await request.json();

    if (!items?.length) {
      return NextResponse.json({ error: 'Cart is empty' }, { status: 400 });
    }

    if (!customerName || !customerEmail) {
      return NextResponse.json({ error: 'Name and email required' }, { status: 400 });
    }

    const checkoutItems = items.map((item: CartItem) => ({
      product_id: item.product.id,
      quantity: item.quantity,
    }));

    // Try RPC first (atomic transaction)
    const { data: rpcResult, error: rpcError } = await supabaseAdmin.rpc('process_checkout', {
      p_website_id: websiteId,
      p_customer_name: customerName,
      p_customer_email: customerEmail,
      p_customer_phone: customerPhone || '',
      p_items: checkoutItems,
    });

    // If RPC exists and succeeded
    if (!rpcError && rpcResult?.success) {
      return NextResponse.json({ success: true, orderId: rpcResult.orderId });
    }

    // If RPC exists but returned an error
    if (!rpcError && rpcResult && !rpcResult.success) {
      return NextResponse.json({ error: rpcResult.error || 'Checkout failed' }, { status: 400 });
    }

    // If RPC doesn't exist, fall back to non-atomic checkout
    // This is less safe but allows the site to work without the SQL function
    if (rpcError?.code === '42883') { // function does not exist
      console.log('process_checkout RPC not found, using fallback checkout');
      return await fallbackCheckout(items, customerName, customerEmail, customerPhone);
    }

    // Other RPC error
    console.error('Checkout RPC error:', rpcError);
    return NextResponse.json({ error: 'Checkout failed. Please try again.' }, { status: 500 });
  } catch (error) {
    console.error('Checkout error:', error);
    return NextResponse.json({ error: 'Checkout failed' }, { status: 500 });
  }
}

async function fallbackCheckout(
  items: CartItem[],
  customerName: string,
  customerEmail: string,
  customerPhone?: string
) {
  const productIds = items.map(i => i.product.id);
  
  const { data: products, error: fetchError } = await supabaseAdmin
    .from('products')
    .select('id, name, price, stock')
    .in('id', productIds)
    .eq('website_id', websiteId)
    .eq('status', 'active');

  if (fetchError || !products) {
    return NextResponse.json({ error: 'Failed to fetch products' }, { status: 500 });
  }

  const productMap = new Map(products.map(p => [p.id, p]));

  // Validate stock
  for (const item of items) {
    const product = productMap.get(item.product.id);
    if (!product) {
      return NextResponse.json({ error: `Product not found: ${item.product.name}` }, { status: 400 });
    }
    if (product.stock < item.quantity) {
      return NextResponse.json({ 
        error: `Insufficient stock for ${product.name} (${product.stock} available)` 
      }, { status: 400 });
    }
  }

  // Decrement stock and build order items
  let total = 0;
  const orderItems: Array<{ productId: string; name: string; price: number; quantity: number }> = [];

  for (const item of items) {
    const product = productMap.get(item.product.id)!;
    
    const { error: updateErr } = await supabaseAdmin
      .from('products')
      .update({ stock: product.stock - item.quantity })
      .eq('id', product.id)
      .eq('website_id', websiteId);

    if (updateErr) {
      console.error('Stock update failed:', updateErr);
      return NextResponse.json({ error: 'Checkout failed during stock update' }, { status: 500 });
    }

    const price = parseFloat(product.price);
    total += price * item.quantity;
    orderItems.push({
      productId: product.id,
      name: product.name,
      price,
      quantity: item.quantity,
    });
  }

  // Create order
  const { data: order, error: orderErr } = await supabaseAdmin
    .from('orders')
    .insert({
      website_id: websiteId,
      customer_name: customerName,
      customer_email: customerEmail,
      customer_phone: customerPhone || null,
      status: 'pending',
      total: total.toFixed(2),
      items: orderItems,
    })
    .select('id')
    .single();

  if (orderErr) {
    console.error('Order creation failed:', orderErr);
    return NextResponse.json({ error: 'Failed to create order' }, { status: 500 });
  }

  return NextResponse.json({ success: true, orderId: order.id });
}
