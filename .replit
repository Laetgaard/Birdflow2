modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["node", "./dist/index.cjs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run tests/renderer-parity.test.tsx"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[agent]
mockupState = "FULLSTACK"
integrations = ["stripe:2.0.0", "javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0", "resend:1.0.0"]

[objectStorage]
defaultBucketID = "replit-objstore-055b6df4-be94-4dc7-8a74-64df0aab8703"

[userenv]

[userenv.shared]
STRIPE_BASIC_PRICE_ID = "price_1SuaIVFkBgbKwqfZM1DyJlXy"
STRIPE_PROFESSIONAL_PRICE_ID = "price_1SuaIWFkBgbKwqfZwU40bosI"
STRIPE_STARTER_PRICE_ID = "price_1SuaIWFkBgbKwqfZUjnpLijN"
BIRDFLOW_PUBLIC_PLATFORM_URL = "https://bird-flow.com"

[userenv.development]
BIRDFLOW_API_URL = "https://bird-flow.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
